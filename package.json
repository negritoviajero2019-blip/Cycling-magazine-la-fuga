{
  "name": "cycling-magazine",
  "version": "0.1.0",
  "private": true,
  "description": "Revista digital profesional de ciclismo — editorial, automatizada y monetizable.",
  "scripts": {
    "predev": "npm run db:dev:generate",
    "dev": "next dev",
    "prebuild": "prisma generate --schema prisma/schema.prisma",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:dev:generate": "prisma generate --schema prisma/schema.dev.prisma",
    "db:dev:migrate": "prisma migrate dev --schema prisma/schema.dev.prisma",
    "db:dev:seed": "tsx prisma/seed.ts",
    "db:dev:studio": "prisma studio --schema prisma/schema.dev.prisma",
    "db:prod:generate": "prisma generate --schema prisma/schema.prisma",
    "db:prod:push": "prisma db push --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@auth/prisma-adapter": "^2.7.4",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "next": "^14.2.15",
    "next-auth": "^4.24.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.15",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.15",
    "postcss": "^8.4.41",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
