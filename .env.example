# ─────────────────────────────────────────────────────────────
# BASE DE DATOS
# Producción (Hostinger MySQL): mysql://usuario:password@host:3306/nombre_bd
# Desarrollo local (SQLite, sin instalar nada): file:./dev.db
# ─────────────────────────────────────────────────────────────
DATABASE_URL="file:./dev.db"

# ─────────────────────────────────────────────────────────────
# SITIO / BRANDING
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_NAME="La Fuga"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_LOCALE="es"
NEXT_PUBLIC_DEFAULT_TIMEZONE="Europe/Madrid"

# ─────────────────────────────────────────────────────────────
# AUTENTICACIÓN ADMIN (Auth.js / NextAuth Credentials)
# Genera NEXTAUTH_SECRET con: openssl rand -base64 32
# ─────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
ADMIN_EMAIL="admin@example.com"
# Hash bcrypt de la contraseña admin (ver docs/ENV.md para generarlo)
ADMIN_PASSWORD_HASH=""

# ─────────────────────────────────────────────────────────────
# AUTOMATIZACIÓN INTERNA (cron jobs de hPanel → endpoints internos)
# Genera un valor aleatorio largo, nunca lo publiques
# ─────────────────────────────────────────────────────────────
CRON_SECRET=""

# ─────────────────────────────────────────────────────────────
# PROVEEDOR DE IA (capa provider-agnostic, ver src/lib/ai/provider.ts)
# Sin esta clave, la automatización queda inactiva (no bloquea el build)
# ─────────────────────────────────────────────────────────────
AI_PROVIDER="anthropic"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# ─────────────────────────────────────────────────────────────
# ANALYTICS (opcional — si se omite, no se carga ningún script)
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=""

# ─────────────────────────────────────────────────────────────
# PUBLICIDAD (opcional — Google AdSense, fase posterior)
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=""
ADS_TXT_CONTENT=""

# ─────────────────────────────────────────────────────────────
# NEWSLETTER (opcional — adapter sin proveedor conectado aún)
# ─────────────────────────────────────────────────────────────
NEWSLETTER_PROVIDER=""
NEWSLETTER_API_KEY=""
